$-- =============================================================================
$-- SOP Metadata Injection + Title Page (Pandoc template partial)
$-- =============================================================================
$-- This file is processed by Pandoc as a TEMPLATE, so $$variable$$ syntax works.
$-- It redefines the LaTeX macros set up by sop-header.tex, then calls the
$-- custom title page command and suppresses Quarto's default \maketitle.
$-- Referenced in _quarto.yml under format > pdf > template-partials.
$-- =============================================================================

$-- Inject YAML metadata into LaTeX macros
$if(sop-number)$
\renewcommand{\sopnumber}{$sop-number$}
$endif$
$if(title)$
\renewcommand{\soptitle}{$title$}
$endif$
$if(revision)$
\renewcommand{\soprevision}{$revision$}
$endif$

$-- Build author string from the author array
$-- Quarto normalizes author metadata into "by-author" with subfield
$-- "name.literal". The old "$for(author)$$author.name$" syntax does
$-- not work because Quarto restructures the author list before Pandoc
$-- sees it. We try by-author first (Quarto), then fall back to the
$-- plain author variable (standalone Pandoc / older Quarto).
$if(by-author)$
\renewcommand{\sopauthor}{$for(by-author)$$by-author.name.literal$$sep$, $endfor$}
$elseif(author)$
\renewcommand{\sopauthor}{$for(author)$$author.name$$sep$, $endfor$}
$endif$

$-- Capture the date
$if(date)$
\renewcommand{\sopdate}{$date$}
$else$
\renewcommand{\sopdate}{\today}
$endif$

$-- Render the custom title page
\maketitlepage

$-- Suppress Quarto's default title block so it does not repeat
\renewcommand{\maketitle}{}
