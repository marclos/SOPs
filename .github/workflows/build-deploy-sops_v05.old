# =============================================================================
# Build and Deploy Lab SOPs (v0.05)
# =============================================================================
# Triggers on push to master (or manual dispatch). Renders all SOPs to HTML
# and PDF, merges PDFs into combined and topic-based sets, adds dust jacket
# covers, then deploys to GitHub Pages.
#
# Setup (one-time):
#   1. In your repo: Settings > Pages > Source > GitHub Actions
#   2. That's it. No tokens or secrets needed.
#
# What's new in v0.05:
#   - Adds dustjackets.R to generate and prepend binder covers to each
#     combined PDF
#   - Adds 'rotating' LaTeX package (needed by dust jacket spine page)
#   - Adds dustjackets.R to paths trigger
#   - Adds pdfpages to LaTeX packages (needed by merge scripts)
# =============================================================================
name: Build and Deploy SOPs

on:
  push:
    branches: [master]
    paths:
      - 'lab_sops/**'
      - 'field_sops/**'
      - 'sops/**'
      - '_quarto.yml'
      - '_templates/**'
      - 'index.qmd'
      - 'merge_sop_pdfs.R'
      - 'dustjackets.R'
      - '.github/workflows/build-deploy-sops.yml'
  workflow_dispatch:

concurrency:
  group: "sop-build"
  cancel-in-progress: true

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build:
    runs-on: ubuntu-latest

    env:
      R_LIBS_USER: ${{ github.workspace }}/R/library
      TZ: America/Los_Angeles

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      # ── TinyTeX (cached) ──────────────────────────────────────────────
      - name: Cache TinyTeX
        id: cache-tinytex
        uses: actions/cache@v5
        with:
          path: |
            ~/bin/TinyTeX
            ~/.TinyTeX
          key: tinytex-${{ runner.os }}-v05-${{ hashFiles('.github/workflows/build-deploy-sops.yml') }}

      - name: Install TinyTeX
        if: steps.cache-tinytex.outputs.cache-hit != 'true'
        uses: r-lib/actions/setup-tinytex@v2

      - name: Ensure TinyTeX is on PATH
        if: steps.cache-tinytex.outputs.cache-hit == 'true'
        run: |
          echo "$HOME/bin" >> "$GITHUB_PATH"
          echo "$HOME/.TinyTeX/bin/x86_64-linux" >> "$GITHUB_PATH"

      - name: Install LaTeX packages
        if: steps.cache-tinytex.outputs.cache-hit != 'true'
        run: |
          tlmgr install \
            fancyhdr lastpage geometry xcolor hyperref \
            booktabs longtable caption float lm etoolbox \
            pdflscape multirow wrapfig colortbl tabu varwidth \
            threeparttable threeparttablex makecell \
            environ trimspaces \
            pdfpages rotating \
            || true

      # ── R (pinned version) ───────────────────────────────────────────
      - name: Setup R
        uses: r-lib/actions/setup-r@v2
        with:
          r-version: '4.4.1'

      # ── R packages (cached) ──────────────────────────────────────────
      - name: Cache R packages
        id: cache-r-packages
        uses: actions/cache@v5
        with:
          path: ${{ env.R_LIBS_USER }}
          key: r-packages-${{ runner.os }}-4.4.1-v05-${{ hashFiles('.github/workflows/build-deploy-sops.yml') }}
          restore-keys: |
            r-packages-${{ runner.os }}-4.4.1-v05-

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            libcurl4-openssl-dev libssl-dev libxml2-dev

      - name: Install R packages
        if: steps.cache-r-packages.outputs.cache-hit != 'true'
        run: |
          mkdir -p "$R_LIBS_USER"
          Rscript -e 'install.packages("pak", repos = "https://cloud.r-project.org", lib = Sys.getenv("R_LIBS_USER"))'
          Rscript -e 'pak::pkg_install(c("knitr", "rmarkdown", "qpdf", "tinytex"), lib = Sys.getenv("R_LIBS_USER"))'

      # ── Quarto ────────────────────────────────────────────────────────
      - name: Setup Quarto
        uses: quarto-dev/quarto-actions/setup@v2

      # ── Render ────────────────────────────────────────────────────────
      - name: Render site
        run: quarto render
        
      # ── Make Quarto's Pandoc available to R scripts ───────────────────
      - name: Add Quarto Pandoc to PATH
        run: |
          PANDOC_DIR="$(dirname "$(quarto pandoc --version 2>/dev/null || true)")"
          QUARTO_PANDOC="$(dirname "$(which quarto)")/../share/pandoc"
          if [ -d "$QUARTO_PANDOC" ]; then
            echo "$QUARTO_PANDOC" >> "$GITHUB_PATH"
          else
            echo "$(quarto --paths | head -1)/bin/tools" >> "$GITHUB_PATH"
          fi

      # ── Collect individual PDFs ───────────────────────────────────────
      - name: Collect PDFs
        run: |
          mkdir -p docs/pdfs
          find docs -name "*.pdf" -not -path "docs/pdfs/*" -exec cp {} docs/pdfs/ \;

      # ── Merge PDFs into combined documents ────────────────────────────
      - name: Merge SOPs into combined PDFs
        run: Rscript merge_sop_pdfs.R docs/pdfs

      # ── Add dust jacket covers ────────────────────────────────────────
      - name: Add dust jackets to combined PDFs
        run: Rscript dustjackets.R --prepend

      # ── Upload for Pages ──────────────────────────────────────────────
      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: docs

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
